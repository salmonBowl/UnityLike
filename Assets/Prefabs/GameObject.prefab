        m_TargetAssemblyTypeName: UnityLike.FrameworkAndDrivers.CodeEditor.CodeEditorUIEvents,
          Base-Assembly
        m_MethodName: OnCodeChangedVoidupdate
        m_Mode: 0
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
