  m_CaretColor: {r: 0, g: 1, b: 0, a: 1}
  m_CustomCaretColor: 1
  m_SelectionColor: {r: 0.40634382, g: 0.58652663, b: 0.81886786, a: 0.7882353}
  m_Text: "if (Input.GetKey(KeyCode.RightArrow))\n{\n    transform.position += new
    Vector3(1, 0, 0);\n}\nif (Input.GetKey(KeyCode.LeftArrow))\n{\n    transform.position
    -= new Vector3(1, 0, 0);\n}\r\n\r\nif (transform.position.y <= -5) //\u3082\u3057\u5730\u9762\u306B\u63A5\u5730\u3057\u3066\u3044\u308B\u306A\u3089\n{\n   
    transform.position.y = -5;\n    velocity.y = 0;\n    \n    if (input.GetKeyDown(KeyCode.UpArrow)\n   
    {\n        velocity.y = 1;\n    }\n}\n\n// \u91CD\u529B\u5206\u3092\u7D99\u7D9A\u7684\u306B\u6E1B\u7B97\nVelocity.y
    -= 0.05f;\n\ntransform.position += Velocity;\n"
